// Detect deferred Annona placeholders by inspecting HTML media renders
$hasAnnona = false;
$firstHtmlMediaId = null;
$firstHtmlMediaRender = null;

foreach ($itemMedia as $media) {
    if ($media->renderer() !== 'html') continue;

    $firstHtmlMediaId = $media->id();
    $firstHtmlMediaRender = $media->render();

    if (strpos($firstHtmlMediaRender, 'data-annona-defer="1"') !== false || strpos($firstHtmlMediaRender, 'class="annona-defer"') !== false) {
        $hasAnnona = true;
    }
    break; // only need the first HTML media for item-show viewer
}
?>

<?php if ($hasAnnona): ?>
