
<?php
$translate = $this->plugin('translate');
?>

<?php if ($prevPage || $nextPage): ?>


    <nav class="exhibition-pagination"
        aria-label="<?= $this->escapeHtmlAttr(
            $translate('Page navigation')
        ) ?>">

        <?php if ($prevPage): ?>
            <a class="exhibition-pagination__link exhibition-pagination__prev"
            href="<?= $this->escapeHtmlAttr($prevPage->siteUrl()) ?>">

                <span class="exhibition-pagination__direction">
                    &larr; <?= $this->escapeHtml($translate('Previous')) ?>
                </span>

                <span class="exhibition-pagination__title">
                    <?= $this->escapeHtml($prevPage->title()) ?>
                </span>

            </a>
        <?php endif; ?>

        <?php if ($nextPage): ?>
            <a class="exhibition-pagination__link exhibition-pagination__next"
            href="<?= $this->escapeHtmlAttr($nextPage->siteUrl()) ?>">

                <span class="exhibition-pagination__direction">
                    <?= $this->escapeHtml($translate('Next')) ?> &rarr;
                </span>

                <span class="exhibition-pagination__title">
                    <?= $this->escapeHtml($nextPage->title()) ?>
                </span>

            </a>
        <?php endif; ?>

    </nav>

<?php endif; ?>
